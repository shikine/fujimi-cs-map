    {
      "id": "T01",
      "title": "農地区画内の楕円形の高まり",
      "lat": 35.944754740339675,
      "lon": 138.25911017570522,
      "tile": "E8-c8_su",
      "spanApproxMetres": 648,
      "decision": "要確認・成因不明",
      "reason": "農地内に独立した不整な楕円形の高まりが見える。航空写真では樹林が残る場所と一致する。自然の残丘、耕地造成時に残された地形、人工の盛土の区別は未確定。周溝・埋葬施設を示す根拠は今回得られていない。",
      "next": "町の遺跡分布図と古い航空写真で照合し、DEMで周囲との比高と断面を確認する。古墳として登録・判定した地点ではない。"
    },
    {
      "id": "T02",
      "title": "丸い窪みに見えた林道の折り返し",
      "lat": 35.94607856215535,
      "lon": 138.32018166545063,
      "tile": "E8-d0_su",
      "spanApproxMetres": 648,
      "decision": "林道形状と整合",
      "reason": "概観時に丸い窪みに見えた部分は、拡大すると連続する道のヘアピンの端に当たる。航空写真にも同じ曲がり方の道が写る。遺跡を示す積極的根拠としては採用しない。",
      "next": "林道の造成時期は未確認。周辺に遺跡がないことを意味しない。"
    },
    {
      "id": "T03",
      "title": "表示地点付近の大きな丘陵",
      "lat": 35.8757603937512,
      "lon": 138.28432030109533,
      "tile": "F1-c9_su",
      "spanApproxMetres": 1215,
      "decision": "丘陵形状・未判定",
      "reason": "最初に表示されていた地点付近。数百m規模で続く丘陵であり、斜面の谷や段差と一体になっている。航空写真では主に樹林。丘全体を古墳とみなす根拠は得られない。",
      "next": "丘陵上の小規模遺構や地下遺構はこの確認では判定できない。町の分布図との範囲照合が必要。"
    }
